QUERYPILOT_DATA_DIR=./data
QUERYPILOT_MODEL_BASE_URL=http://127.0.0.1:8000/v1
QUERYPILOT_MODEL_NAME=Qwen/Qwen2.5-Coder-7B-Instruct
QUERYPILOT_MODEL_API_KEY=local
# 仅在服务端支持 temperature 时启用；GPT-5.5 可保持未设置。
# QUERYPILOT_MODEL_TEMPERATURE=0
QUERYPILOT_QUERY_TIMEOUT_MS=3000
QUERYPILOT_MAX_ROWS=100
QUERYPILOT_MAX_RESPONSE_BYTES=262144

# R2：知识存储按需加载；不覆盖现有 .env，不向聊天/日志输出真实凭据。
# 先拉此版本标签，再以真实 image@sha256:... 固定实际镜像。
# QUERYPILOT_PG_IMAGE=pgvector/pgvector:0.8.7-pg18-bookworm
# 上面是 R2 基础镜像示例，不自带 pg_search；R3 固定 pg_search0.26.4。
# 本机已直接安装在现有容器，重启会保留；删除重建前需改用包含插件的固定镜像。
# knowledge store prepare-search 只准备数据库扩展/索引，不能安装容器系统包。
# QUERYPILOT_PG_PORT=5432
# QUERYPILOT_PG_ADMIN_PASSWORD=<本机设置>
# QUERYPILOT_KNOWLEDGE_ADMIN_DSN=postgresql://postgres:<密码>@127.0.0.1:5432/querypilot_knowledge
# QUERYPILOT_KNOWLEDGE_IMPORT_DSN=postgresql://querypilot_kb_importer:<密码>@127.0.0.1:5432/querypilot_knowledge
# QUERYPILOT_KNOWLEDGE_READ_DSN=postgresql://querypilot_kb_reader:<密码>@127.0.0.1:5432/querypilot_knowledge
# QUERYPILOT_KNOWLEDGE_CONNECT_TIMEOUT_S=5
# QUERYPILOT_KNOWLEDGE_LOCK_TIMEOUT_MS=5000
# QUERYPILOT_KNOWLEDGE_STATEMENT_TIMEOUT_MS=30000
# 测试库需显式创建；运行角色密码与同一实例上的上述固定角色一致。
# QUERYPILOT_KNOWLEDGE_TEST_ADMIN_DSN=postgresql://postgres:<密码>@127.0.0.1:5432/querypilot_knowledge_test
# QUERYPILOT_KNOWLEDGE_TEST_IMPORT_DSN=postgresql://querypilot_kb_importer:<密码>@127.0.0.1:5432/querypilot_knowledge_test
# QUERYPILOT_KNOWLEDGE_TEST_READ_DSN=postgresql://querypilot_kb_reader:<密码>@127.0.0.1:5432/querypilot_knowledge_test

# 运行配置、事件、私有结果和日期日志的统一根；不替代知识快照 output-dir。
QUERYPILOT_ARTIFACTS_DIR=artifacts
